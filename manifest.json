{
  "manifest_version": 3,
  "name": "YouTube Auto Continue",
  "version": "1.0.0",
  "description": "Tự động bấm 'Có / Tiếp tục xem' khi YouTube tạm dừng video (Video paused. Continue watching?).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

